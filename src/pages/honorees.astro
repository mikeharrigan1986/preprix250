---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const pastCategories = [
  {
    icon: "🏎️",
    title: "Racing Drivers & Champions",
    desc: "Exceptional drivers who've defined the sport with their skill, courage, and competitive spirit"
  },
  {
    icon: "🔧",
    title: "Team Owners & Engineers",
    desc: "Those who've built legendary racing teams and engineered machines that push the limits of performance"
  },
  {
    icon: "⚙️",
    title: "Automotive Innovators",
    desc: "Pioneers in automotive technology and design whose innovations have transformed the industry"
  },
  {
    icon: "🎙️",
    title: "Motorsport Media & Broadcasting",
    desc: "Journalists and broadcasters who've brought racing to the world and captured its greatest moments"
  },
  {
    icon: "🛡️",
    title: "Racing Safety & Advocacy",
    desc: "Those who've made motorsport safer through innovation, regulation, and tireless advocacy"
  },
  {
    icon: "🏁",
    title: "Community & Grassroots Racing",
    desc: "Champions of local and grassroots motorsport development who nurture the next generation of talent"
  },
];
---

<BaseLayout title="Racing Legends | Pre-Prix 250" description="Learn about the Racing Legends Lifetime Achievement Awards, past honorees, and how to nominate a motorsport legend for recognition at Pre-Prix 250.">
  <Navbar />
  <main>
    <!-- Hero header -->
    <section class="relative pt-32 pb-20 bg-navy text-white overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-navy-dark/90 to-navy"></div>
      <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
        <p class="text-gold font-medium tracking-[0.2em] uppercase text-sm mb-4">Honoring Those Who Define the Sport</p>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-white mb-4 font-heading">Racing Legends</h1>
        <div class="w-20 h-1 bg-red mx-auto mb-6"></div>
        <p class="text-white/70 text-lg max-w-2xl mx-auto">Recognizing extraordinary individuals whose lifetime of achievement, innovation, and passion has shaped the world of motorsport.</p>
      </div>
    </section>

    <!-- About the Awards -->
    <section class="py-20 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-navy mb-6 font-heading">The Racing Legends Lifetime Achievement Awards</h2>
          <div class="w-16 h-1 bg-gold mx-auto"></div>
        </div>

        <div class="text-slate/70 text-lg leading-relaxed space-y-6">
          <p>
            The <strong class="text-navy">Racing Legends Lifetime Achievement Awards</strong> honor a select group of
            individuals who have dedicated their lives to the world of motorsport. These awards recognize those whose
            courage, innovation, and passion have made a lasting impact on racing.
          </p>
          <p>
            At <strong class="text-navy">Pre-Prix 250</strong> on August 22, 2026, we will
            present Lifetime Achievement Awards to outstanding individuals who
            represent the very best of motorsport as we celebrate the thrill and legacy of racing.
          </p>
          <p>
            Past honorees have included legendary drivers, pioneering engineers, groundbreaking
            team owners, tireless safety advocates, and other extraordinary figures whose contributions
            to motorsport inspire us all. Each honoree is recognized on stage during a stirring awards
            ceremony that is one of the most powerful and memorable moments of the evening.
          </p>
        </div>
      </div>
    </section>

    <!-- Past Categories -->
    <section class="py-20 bg-cream">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-navy mb-4 font-heading">Fields of Achievement</h2>
          <p class="text-slate/60 text-lg max-w-2xl mx-auto">Racing Legends Award recipients can come from any area of motorsport, but all share a common thread — a lifetime of extraordinary contribution to the racing world.</p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {pastCategories.map((cat) => (
            <div class="bg-white rounded-xl p-6 shadow-sm border border-slate/5">
              <div class="text-3xl mb-3">{cat.icon}</div>
              <h3 class="text-lg font-bold text-navy mb-2">{cat.title}</h3>
              <p class="text-slate/60 text-sm leading-relaxed">{cat.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- What Makes a Racing Legend -->
    <section class="py-20 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-navy mb-4 font-heading">What Makes a Racing Legend?</h2>
          <div class="w-16 h-1 bg-gold mx-auto"></div>
        </div>

        <div class="text-slate/70 text-lg leading-relaxed mb-10">
          <p>Award recipients are chosen based on the following criteria:</p>
        </div>

        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-red/10 flex items-center justify-center flex-shrink-0 mt-1">
              <span class="text-red font-bold text-sm">1</span>
            </div>
            <div>
              <h3 class="font-bold text-navy text-lg mb-1">Lifetime of Achievement</h3>
              <p class="text-slate/60">A sustained, long-term commitment to motorsport excellence — not a single victory, but a lifetime of dedication to the sport.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-red/10 flex items-center justify-center flex-shrink-0 mt-1">
              <span class="text-red font-bold text-sm">2</span>
            </div>
            <div>
              <h3 class="font-bold text-navy text-lg mb-1">Innovation & Excellence</h3>
              <p class="text-slate/60">A demonstrated pattern of pushing boundaries, whether on the track, in the garage, or behind the scenes.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-red/10 flex items-center justify-center flex-shrink-0 mt-1">
              <span class="text-red font-bold text-sm">3</span>
            </div>
            <div>
              <h3 class="font-bold text-navy text-lg mb-1">Lasting Impact</h3>
              <p class="text-slate/60">Contributions that have made a measurable, lasting difference in the sport, the industry, or the racing community as a whole.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-red/10 flex items-center justify-center flex-shrink-0 mt-1">
              <span class="text-red font-bold text-sm">4</span>
            </div>
            <div>
              <h3 class="font-bold text-navy text-lg mb-1">Exemplary Character</h3>
              <p class="text-slate/60">Integrity, sportsmanship, and leadership that inspires others to pursue excellence in motorsport.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-red/10 flex items-center justify-center flex-shrink-0 mt-1">
              <span class="text-red font-bold text-sm">5</span>
            </div>
            <div>
              <h3 class="font-bold text-navy text-lg mb-1">Embodies the Spirit of Racing</h3>
              <p class="text-slate/60">Represents the values of courage, determination, innovation, and passion that define the best of motorsport.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Nominations -->
    <section class="py-20 bg-navy text-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
        <p class="text-gold font-medium tracking-[0.2em] uppercase text-sm mb-4">Nominations Now Open</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6 font-heading">Nominate a Racing Legend</h2>
        <div class="w-16 h-1 bg-gold mx-auto mb-8"></div>

        <div class="text-white/70 text-lg leading-relaxed space-y-6 text-left max-w-2xl mx-auto mb-12">
          <p>
            We are now accepting nominations for the 2026 Racing Legends Lifetime Achievement Awards.
            Do you know someone who has dedicated their life to motorsport? Someone whose skill,
            innovation, and passion have made a real difference in the racing world?
          </p>
          <p>
            We invite you to submit their name for consideration. Nominees can come from any area
            of motorsport — what matters is their lifetime of extraordinary contribution.
          </p>
          <p class="text-white/50 text-base">
            <strong class="text-white/70">To submit a nomination, please include:</strong>
          </p>
          <ul class="text-white/60 text-base space-y-2 list-none">
            <li class="flex items-start gap-3">
              <span class="text-gold mt-0.5">★</span>
              <span>Nominee's full name and location</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-gold mt-0.5">★</span>
              <span>Their area of motorsport</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-gold mt-0.5">★</span>
              <span>A brief description of their lifetime of contributions (250 words or less)</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-gold mt-0.5">★</span>
              <span>Why you believe they exemplify the spirit of a Racing Legend</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-gold mt-0.5">★</span>
              <span>Your name and contact information</span>
            </li>
          </ul>
        </div>

        <a
          href="#"
          class="inline-block bg-red hover:bg-red-light text-white px-10 py-4 text-lg font-semibold tracking-wider uppercase transition-all rounded shadow-lg hover:-translate-y-0.5"
        >
          Submit a Nomination
        </a>
        <p class="text-white/40 text-sm mt-4">Nominations will be reviewed by our Awards Committee. All submissions are confidential.</p>
      </div>
    </section>

    <!-- 2026 Honorees Teaser -->
    <section class="py-20 bg-cream">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
        <h2 class="text-3xl sm:text-4xl font-bold text-navy mb-6 font-heading">2026 Honorees</h2>
        <div class="w-16 h-1 bg-gold mx-auto mb-8"></div>
        <div class="bg-white rounded-2xl p-10 shadow-sm border border-slate/5">
          <svg class="w-12 h-12 text-gold mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
          </svg>
          <h3 class="text-xl font-bold text-navy mb-3">Coming Soon</h3>
          <p class="text-slate/60 text-lg">
            The 2026 Racing Legends Lifetime Achievement Award honorees will be announced as the event approaches.
            Follow us on social media and check our <a href="/updates/" class="text-red hover:text-red-light underline">News & Updates</a> page for announcements.
          </p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 bg-red text-center">
      <div class="max-w-3xl mx-auto px-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4 font-heading">Be There for the Awards Ceremony</h2>
        <p class="text-white/80 mb-6">
          Witness these extraordinary motorsport legends receive their Lifetime Achievement Awards in person at Pre-Prix 250.
        </p>
        <a
          href="/#tickets"
          class="inline-block bg-white text-red px-10 py-4 text-lg font-semibold tracking-wider uppercase hover:bg-cream transition-colors rounded shadow-lg"
        >
          Get Your Tickets
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
