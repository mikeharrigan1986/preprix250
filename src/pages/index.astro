---
// Pre-Prix 250 placeholder page.
//
// The event has not been formally confirmed (decision pending as of
// 2026-06-26 per Mike). All previous pages live in src/pages/_disabled/
// to preserve the work in git history; Astro ignores the underscore-
// prefixed folder so nothing builds out of it.
//
// To restore the full site when the event is confirmed:
//   git mv src/pages/_disabled/*.astro src/pages/
//   git restore (a prior commit of) src/pages/index.astro
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Pre-Prix 250</title>
    <style>
      :root {
        color-scheme: dark;
      }
      html, body {
        margin: 0;
        padding: 0;
        height: 100%;
        background: #050912;
        color: #e6e8ee;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      .wrap {
        min-height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        box-sizing: border-box;
        text-align: center;
        background:
          radial-gradient(ellipse at 50% 0%, rgba(40, 70, 150, 0.18) 0%, transparent 60%),
          #050912;
      }
      .card {
        max-width: 32rem;
      }
      .eyebrow {
        color: #b8881a;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.4em;
        text-transform: uppercase;
        margin: 0 0 1.25rem;
      }
      h1 {
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        font-weight: 700;
        letter-spacing: -0.01em;
        margin: 0 0 0.75rem;
        color: #ffffff;
      }
      .sub {
        color: rgba(230, 232, 238, 0.65);
        font-size: 1rem;
        line-height: 1.6;
        margin: 0;
      }
      .rule {
        width: 4rem;
        height: 1px;
        background: rgba(184, 136, 26, 0.5);
        margin: 1.75rem auto;
      }
      .small {
        color: rgba(230, 232, 238, 0.4);
        font-size: 0.8125rem;
        line-height: 1.5;
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="card">
        <p class="eyebrow">Pre-Prix 250</p>
        <h1>Site under development.</h1>
        <p class="sub">Check back later for updates.</p>
        <div class="rule"></div>
        <p class="small">For event inquiries, please contact the organizers directly.</p>
      </div>
    </div>
  </body>
</html>
